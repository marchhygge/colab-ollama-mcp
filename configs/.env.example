# Environment variables for Colab Ollama MCP Server
# Copy this file to .env or export in your shell profile before launching the MCP server.

# Public Cloudflare Quick Tunnel URL pointing to the remote Google Colab Ollama daemon
OLLAMA_ENDPOINT=https://your-tunnel-name.trycloudflare.com

# Default Ollama model tag to use when not overridden per tool call (T4 16GB / A100 40GB)
OLLAMA_MODEL=qwen2.5-coder:14b

# HTTP socket timeout in seconds for remote inference requests over the tunnel
OLLAMA_TIMEOUT=180
